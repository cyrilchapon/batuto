{
  "name": "@batuto/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist-types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "env:pull": "doppler secrets download --project=batuto-db --config=dev_personal --no-file --format=env > .env",
    "db:branch": "dotenv -e .env -- node scripts/db-branch.mjs",
    "check:type": "tsgo -p tsconfig.json --noEmit",
    "codegen": "prisma generate",
    "build": "tsgo -p tsconfig.build.json",
    "build:declaration": "tsgo -p tsconfig.declaration.json",
    "migrate:dev": "dotenv -e .env.local -e .env -- prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "dotenv -e .env.local -e .env -- prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0"
  },
  "devDependencies": {
    "@batuto/config-typescript": "workspace:*",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.8.0",
    "typescript": "^5.9.3"
  }
}

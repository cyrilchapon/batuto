{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["doppler"],
  "workspaces": {
    "packages/dtos": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/contract": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/db": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@prisma/client"]
    },
    "apps/api": {
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "project": ["app/**/*.{ts,tsx}"],
      "ignore": ["app/components/ui/**"],
      "ignoreDependencies": [
        "@fontsource-variable/geist",
        "shadcn",
        "tailwindcss",
        "tw-animate-css"
      ]
    }
  }
}

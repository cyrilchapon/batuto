{
  "name": "@batuto/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "yarn": "4.17.1"
  },
  "scripts": {
    "env:pull": "doppler secrets download --project=batuto-api --config=dev_personal --no-file --format=env > .env",
    "dev": "dotenv -e .env.local -e .env -- tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "check:type": "tsgo -p tsconfig.json --noEmit",
    "test": "dotenv -e .env.local -e .env -- vitest run"
  },
  "dependencies": {
    "@batuto/auth": "workspace:*",
    "@batuto/contract": "workspace:*",
    "@batuto/db": "workspace:*",
    "@batuto/env": "workspace:*",
    "@orpc/openapi": "^1.14.8",
    "@orpc/server": "^1.14.8",
    "@orpc/standard-server-node": "^1.14.8",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@batuto/config-typescript": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "dotenv-cli": "^11.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

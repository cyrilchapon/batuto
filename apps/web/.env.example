# Local dev default. In deployed environments this comes from Doppler, never
# set by hand — see .agents/context/engineering/overview/infra-and-envs.md.
VITE_API_URL="http://localhost:3001"

# Clerk. VITE_CLERK_PUBLISHABLE_KEY is not secret and reaches the client
# bundle; CLERK_SECRET_KEY is server-only (used by rootAuthLoader during SSR)
# and must never be referenced from client-reachable code.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
